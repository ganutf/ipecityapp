  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --bundle --format=esm --outdir=dist --banner:js=\"import { createRequire as _cr } from 'module'; import { fileURLToPath as _fp } from 'url'; import { dirname as _dn } from 'path'; const require = _cr(import.meta.url); const __filename = _fp(import.meta.url); const __dirname = _dn(__filename);\" --external:bufferutil --external:utf-8-validate --external:keccak --external:secp256k1 --external:pg-native --external:canvas --external:lightningcss --external:@babel/preset-typescript",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "node server/scripts/migrate.mjs",
    "admin:create": "tsx server/scripts/create-admin.ts",
    "admin:list": "tsx server/scripts/list-admins.ts",
    "keys:migrate": "tsx server/scripts/migrate-keys.ts",
    "member:delete": "tsx server/scripts/delete-member.ts",
    "members:verify-addresses": "tsx server/scripts/verify-member-addresses.ts",
    "attestations:create": "tsx server/scripts/create-attestations.ts",
    "wallet:attestation": "tsx server/scripts/get-attestation-wallet.ts",
    "migrate:pulse-structure": "tsx server/scripts/migrate-pulse-structure.ts",
    "rollback:pulse-structure": "tsx server/scripts/rollback-pulse-migration.ts",
    "populate:pulse-types": "tsx server/scripts/populate-pulse-types.ts",
    "test-users:generate": "tsx server/scripts/generate-test-users.ts",
    "test-streak:compare": "tsx server/scripts/test-streak-calculation.ts",
    "test-active:status": "tsx server/scripts/test-active-pulse-status.ts",
    "onboarding": "tsx server/scripts/test-onboarding.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "production:check": "bash scripts/production-check.sh",
    "production:deploy": "npm run production:check && npm run build && npm run start"
  },
