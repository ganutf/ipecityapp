# Environment Configuration
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ipecity_pulse

# API Keys
NEYNAR_API_KEY=your_neynar_api_key
JUSTANAME_API_KEY=your_justaname_api_key
RESEND_API_KEY=your_resend_api_key

# Farcaster Configuration
VITE_NEYNAR_CLIENT_ID=your_neynar_client_id
VITE_NEYNAR_SIGNER_UUID=your_neynar_signer_uuid
FARCASTER_DEVELOPER_MNEMONIC=your_farcaster_developer_mnemonic

# Client-side Configuration
VITE_JUSTANAME_API_KEY=your_justaname_api_key
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Security Configuration
SESSION_SECRET=your_secure_32_plus_character_session_secret

# Email Configuration
EMAIL_TEST_MODE=false

# EAS (Ethereum Attestation Service) Configuration
# Chain selection - determines network, RPC URL, and contract addresses
# Options: 'base-sepolia' (testnet) or 'base' (mainnet)
CHAIN=base-sepolia

# Client-side chain configuration (must match CHAIN for consistent behavior)
VITE_CHAIN=base-sepolia

# EAS RPC URL - Used for attestations (testnet in dev, mainnet in prod)
# For base-sepolia: https://sepolia.base.org (default)
# For base: https://mainnet.base.org (default)
EAS_RPC_URL=https://sepolia.base.org

# Base Mainnet RPC - Used for IPE token balance fetching (always mainnet)
# Recommended: Use a dedicated RPC provider (CDP, Alchemy) for production
# Example: https://api.developer.coinbase.com/rpc/v1/base/YOUR-API-KEY
BASE_MAINNET_RPC_URL=

# Attestation wallet configuration (separate from Farcaster wallet)
EAS_ATTESTATION_MNEMONIC=your_eas_attestation_mnemonic

# ENS Subgraph (TheGraph) — used to enumerate *.ipecity.eth passports
# for a wallet during onboarding. Free tier works for low-volume use.
# Sign up at https://thegraph.com/studio/ and create an API key.
THEGRAPH_API_KEY=
# ENS subgraph on TheGraph decentralized network (default is the official ENS subgraph).
THEGRAPH_ENS_SUBGRAPH_ID=5XqPmWe6gjyrJtFn9cLy237i4cWw2j9HcUJEXsP5qGtH

# Production-specific (only for production)
FRONTEND_URL=https://pulse.ipecity.org