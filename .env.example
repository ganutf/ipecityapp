# Environment Configuration
NODE_ENV=development

# Database Configuration
# NOTE: In production, this should be managed via secure key management (.keys/ directory)
DATABASE_URL=postgresql://user:password@localhost:5432/ipecity_pulse

# API Keys (store securely in production)
NEYNAR_API_KEY=your_neynar_api_key
JUSTANAME_API_KEY=your_justaname_api_key
RESEND_API_KEY=your_resend_api_key

# Farcaster Configuration  
VITE_NEYNAR_CLIENT_ID=your_neynar_client_id
VITE_NEYNAR_SIGNER_UUID=your_neynar_signer_uuid
FARCASTER_DEVELOPER_MNEMONIC=your_farcaster_developer_mnemonic

# Client-side Configuration
VITE_JUSTANAME_API_KEY=your_justaname_api_key
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Security Configuration
SESSION_SECRET=your_secure_32_plus_character_session_secret

# Email Configuration
EMAIL_TEST_MODE=false

# EAS (Ethereum Attestation Service) Configuration
# For development: https://sepolia.base.org (Base Sepolia testnet)
# For production: https://mainnet.base.org (Base mainnet)
BASE_RPC_URL=https://sepolia.base.org
EAS_PRIVATE_KEY=your_private_key_for_eas_attestations

# Production-specific (only for production)
FRONTEND_URL=https://pulse.ipecity.org